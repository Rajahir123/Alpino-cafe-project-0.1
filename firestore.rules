rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection Test Document
    match /test/connection {
      allow read: if true;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.get('email', '') == 'denyteny123@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isKitchen() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'kitchen';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- User Validation ---
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'planStatus']) &&
             data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             data.role in ['user', 'admin', 'kitchen'] &&
             data.planStatus in ['none', 'pending', 'active', 'expired'] &&
             (data.get('phone', null) == null || (data.phone is string && data.phone.size() <= 32)) &&
             (data.get('address', null) == null || (data.address is string && data.address.size() <= 1000));
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin() || isKitchen();
      allow list: if request.auth.token.get('email', '') == 'denyteny123@gmail.com' || isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming()) && (
        incoming().role == 'user' || 
        (incoming().role == 'admin' && request.auth.token.get('email', '') == 'denyteny123@gmail.com')
      );
      allow update: if (isOwner(userId) || isAdmin()) && (
        // Action: Update Profile (User) - Restricted to non-sensitive fields
        (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'address', 'gender', 'occupation', 'primaryGoal', 'workoutFrequency', 'mealPreference', 'foodAllergies', 'consumptionMethod', 'preferredTimeSlot', 'upgradeMeals', 'socialMediaFeature', 'fitnessTips', 'heardAboutUs', 'startDate', 'proteinGoal', 'planId', 'planStatus', 'updatedAt', 'avgProtein', 'drafts'])) ||
        // Action: Admin adjustments - Admin can change anything
        (isAdmin())
      );
    }

    // --- Menu Validation ---
    function isValidMenuItem(data) {
      return data.keys().hasAll(['name', 'category', 'protein']) &&
             data.name is string && data.name.size() <= 256 &&
             data.category in ['Bowl', 'Smoothie', 'Smoothies', 'Shake', 'Wrap', 'Wraps', 'Sub', 'Oats'] &&
             data.protein is number &&
             (data.get('calories', null) == null || data.calories is number) &&
             (data.get('price', null) == null || data.price is number) &&
             (data.get('description', null) == null || data.description is string) &&
             (data.get('bgImage', null) == null || data.bgImage is string) &&
             (data.get('spinningImage', null) == null || data.spinningImage is string) &&
             (data.get('published', null) == null || data.published is bool);
    }

    match /menu/{itemId} {
      allow get, list: if true;
      allow create, update: if isAdmin() && isValidMenuItem(incoming());
      allow delete: if isAdmin();
    }

    // --- Plans ---
    match /plans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Orders ---
    function isValidOrder(data) {
      return data.keys().hasAll(['userId', 'items', 'status', 'date']) &&
             data.userId is string &&
             data.items is list && data.items.size() > 0 &&
             data.status in ['pending', 'preparing', 'out-for-delivery', 'delivered'];
    }

    match /orders/{orderId} {
      allow get: if isOwner(resource.data.userId) || isAdmin() || isKitchen();
      allow list: if isAdmin() || isKitchen() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isOwner(incoming().userId) && isValidOrder(incoming());
      allow update: if (isOwner(existing().userId) || isAdmin() || isKitchen()) && (
        (isOwner(existing().userId) && incoming().diff(existing()).affectedKeys().hasOnly(['items', 'createdAt', 'id', 'userName', 'date', 'status', 'userId'])) ||
        (isKitchen() && incoming().diff(existing()).affectedKeys().hasOnly(['status'])) ||
        isAdmin()
      );
    }

    // --- Payments ---
    function isValidPayment(data) {
      return data.userId == request.auth.uid &&
             (data.status == 'pending' || data.status == 'submitted');
    }

    match /payments/{paymentId} {
      allow get: if isOwner(resource.data.userId) || isAdmin();
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isValidPayment(incoming());
      allow update: if isAdmin() && incoming().status in ['approved', 'rejected'];
    }

    // --- Assets ---
    match /assets/{assetId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Settings ---
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Drafts ---
    match /users/{userId}/drafts/{panelId} {
      allow read, write: if isOwner(userId);
    }

    // --- Notes (Admin Records) ---
    match /notes/{noteId} {
      allow read, write: if isAdmin();
    }
  }
}
